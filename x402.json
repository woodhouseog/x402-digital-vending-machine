{
  "x402Version": 2,
  "resource": {
    "url": "https://www.x402digitalvendingmachine.store/v1/schema-gate",
    "method": "POST",
    "description": "Return a signed ACCEPT or REJECT verdict for JSON against a bounded target schema and committed acceptance policy.",
    "mimeType": "application/json",
    "inputSchema": {
      "$ref": "https://www.x402digitalvendingmachine.store/openapi.json#/components/schemas/SchemaGateRequest"
    }
  },
  "accepts": [
    {
      "scheme": "exact",
      "network": "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp",
      "amount": "10000",
      "asset": "EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v",
      "payTo": "E2PxHWFSwzt6a3osZRQeT16tsb7BPLfXEMuDfjnZuhFD",
      "maxTimeoutSeconds": 600
    }
  ],
  "extensions": {
    "normalizerVersion": "schema-gate-c14n-v1",
    "acceptanceCommitment": "sha256:<lowercase SHA-256 hex of canonical acceptance_criteria JSON>",
    "recovery": "https://www.x402digitalvendingmachine.store/v1/orders/{order_id}",
    "receiptKey": "https://www.x402digitalvendingmachine.store/.well-known/receipt-key.json",
    "billing": {
      "displayAmount": "0.010 USDC",
      "unit": "completed signed evaluation",
      "paidVerdicts": ["ACCEPT", "REJECT"],
      "unsettledFailures": ["malformed preflight", "payment", "provider"],
      "idempotentRecovery": "no additional charge"
    }
  }
}
